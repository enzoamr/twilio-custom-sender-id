# Copiez ce fichier en .env et renseignez vos identifiants Twilio.
# Récupérez-les sur https://console.twilio.com
# NE COMMITTEZ JAMAIS le fichier .env (il est dans .gitignore).
#
# Vous pouvez choisir L'UNE des deux méthodes d'authentification ci-dessous.

# Account SID (toujours requis) — commence par AC..., visible sur le dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Méthode 1 : API Key (RECOMMANDÉE, révocable sans toucher au compte) ---
# Account > API keys & tokens > Create API key
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# --- Méthode 2 : Auth Token (classique) ---
# À utiliser à la place de l'API Key ci-dessus (laissez l'autre méthode vide).
# TWILIO_AUTH_TOKEN=your_auth_token_here
